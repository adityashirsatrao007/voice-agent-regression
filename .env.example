# OpenAI-compatible API key for `--backend llm` (Sarvam AI or any
# chat.completions endpoint). Copy this file to `.env` and fill it in;
# `.env` is gitignored. Not needed for the default mock backend or for tests.
LLM_API_KEY=

# Fallback key name honoured by the same backend:
# SARVAM_API_KEY=

# Optional overrides (defaults shown; base URL and model are read from
# src/vareg/backends/llm.py — LLM_MODEL is required for --backend llm)
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=
